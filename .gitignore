# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging/build artifacts
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter
.ipynb_checkpoints/

# IDE/editor and OS temp files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Large generated analysis artifacts
*.parquet
*.feather
*.h5
*.hdf5
*.pkl
*.joblib
*.npy
*.npz
*.zip
*.7z
*.gz

# Generated processed data (can become large)
dados/tratado/**/*.csv

# Keep raw ANP CSVs versioned
!dados/bruto/**/*.csv
